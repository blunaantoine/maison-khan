# Configuration MAISON KHAN
# Copiez ce fichier en .env et remplissez les valeurs.
# ⚠️ Ne JAMAIS committer le vrai .env ni de vraies clés dans ce fichier.

# Base de données
DATABASE_URL=file:/var/www/maison-khan/db/custom.db

# ============================================================
# Session JWT (authentification du site)
# Générer : openssl rand -hex 32
# ============================================================
JWT_SECRET=generate_a_random_64_char_secret_here

# ============================================================
# Connexion avec Google (OAuth 2.0)
# 1. https://console.cloud.google.com/apis/credentials
# 2. « Créer des identifiants » → « ID client OAuth 2.0 » → Application Web
# 3. URI de redirection autorisée : https://shop.maison-khan.com/api/auth/google/callback
# Tant que ces valeurs sont vides, le bouton « Continuer avec Google »
# n'est pas affiché sur le site.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Optionnel) URI de retour OAuth exacte si l'autodétection derrière le
# proxy ne convient pas. Par défaut : https://<domaine>/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://shop.maison-khan.com/api/auth/google/callback

# ============================================================
# Assistant IA — Mistral (analyse des photos produits)
# 1. Créez un compte sur https://console.mistral.ai
#    (le plan gratuit « Experiment » suffit pour l'assistant IA)
# 2. Générez une clé API : https://console.mistral.ai/api-keys
# 3. Collez-la ci-dessous puis redémarrez : pm2 restart maison-khan
# Sans cette clé, le bouton « ✨ Analyser la photo » du formulaire
# d'ajout de produit affiche un message d'erreur clair.
# ============================================================
MISTRAL_API_KEY=your_mistral_api_key_here
# Modèle de vision Mistral :
#  - pixtral-12b-2409      : rapide et économique (gratuit sur le plan Experiment)
#  - pixtral-large-latest  : plus précis (payant)
#  - mistral-small-latest  : équilibré
MISTRAL_VISION_MODEL=pixtral-12b-2409

# ============================================================
# Emails (Resend) — https://resend.com/api-keys
# ============================================================
RESEND_API_KEY=your_resend_api_key_here

# ============================================================
# PayDunya (paiements Mobile Money) — https://app.paydunya.com/settings/api/keys
# ============================================================
PAYDUNYA_MASTER_KEY=your_paydunya_master_key_here
PAYDUNYA_PRIVATE_KEY=your_paydunya_private_key_here
PAYDUNYA_TOKEN=your_paydunya_token_here
PAYDUNYA_MODE=test  # 'test' ou 'live'

# PayGate (ancien système — garder si encore utilisé)
PAYGATE_AUTH_TOKEN=your_paygate_token_here
PAYGATE_BASE_URL=https://paygateglobal.com/api/v1

# URL du site (pour les notifications)
NEXT_PUBLIC_BASE_URL=https://shop.maison-khan.com

# ============================================================
# Webhook de déploiement (/api/deploy)
# ============================================================
# Secret : générer une chaîne aléatoire de 32+ caractères
DEPLOY_SECRET=generate_a_random_32_char_secret_here
# Branche déployée par le webhook (défaut : fusion/dashboard+mmi, la branche de production)
DEPLOY_BRANCH=fusion/dashboard+mmi

# Secret pour protéger le cron de vérification des paiements
CRON_SECRET=generate_another_random_secret_here

# Mots de passe pour le script de seed admin (à utiliser une seule fois)
# SEED_ADMIN_PASSWORD=...
# SEED_MANAGER_PASSWORD=...
