# Configuration MAISON KHAN
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données
DATABASE_URL=file:/var/www/maison-khan/db/custom.db

# Resend API (pour les emails)
# Obtenir une clé sur https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# PayDunya (pour les paiements Mobile Money)
# Obtenir vos clés sur https://app.paydunya.com/settings/api/keys
PAYDUNYA_MASTER_KEY=your_paydunya_master_key_here
PAYDUNYA_PRIVATE_KEY=your_paydunya_private_key_here
PAYDUNYA_TOKEN=your_paydunya_token_here
PAYDUNYA_MODE=test  # 'test' ou 'live'

# PayGate (ancien système — garder si encore utilisé)
PAYGATE_AUTH_TOKEN=your_paygate_token_here
PAYGATE_BASE_URL=https://paygateglobal.com/api/v1

# URL du site (pour les notifications)
NEXT_PUBLIC_BASE_URL=https://maison-khan.com

# Secret du webhook de déploiement (générer une chaîne aléatoire de 32+ caractères)
DEPLOY_SECRET=generate_a_random_32_char_secret_here

# Branche déployée par le webhook /api/deploy (défaut : mobile-money-integration, la branche principale)
DEPLOY_BRANCH=mobile-money-integration

# Secret pour protéger le cron de vérification des paiements
CRON_SECRET=generate_another_random_secret_here

# Mots de passe pour le script de seed admin (à utiliser une seule fois)
# SEED_ADMIN_PASSWORD=...
# SEED_MANAGER_PASSWORD=...
